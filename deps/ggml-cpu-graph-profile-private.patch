+static void ei_cpu_profile_print(const struct ggml_cgraph * graph,
+        const struct ei_cpu_node_sample * samples, int threads,
+        int64_t graph_us, int64_t create_us, int64_t free_us, bool disposable) {
+    // Sum of per-node worker maxima is not additive with wait maxima.
+    // Worker0 work+wait is the attributable wall path; CPU sums size imbalance.
+    fprintf(stderr, "cpu graph profile: nodes=%d threads=%d disposable=%d graph_us=%" PRId64
+        " pool_create_us=%" PRId64 " pool_free_us=%" PRId64 "\n",
+        graph->n_nodes, threads, disposable, graph_us, create_us, free_us);
+    for (int bucket = 0; bucket <= GGML_OP_COUNT; ++bucket) {
+        int nodes = 0, fused = 0, kernel_barriers = 0;
+        int64_t kernel_wait = 0, w0_kernel_wait = 0;
+        int64_t work = 0, wait = 0, max_work = 0, max_wait = 0, w0_work = 0, w0_wait = 0;
+        const char * name = NULL;
+        for (int n = 0; n < graph->n_nodes; ++n) {
+            const struct ggml_tensor * node = graph->nodes[n];
+            int group = node->op;
+            if (node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_GELU)
+                group = GGML_OP_COUNT;
+            if (group != bucket || !samples[n].visited) continue;
+            ++nodes;
+            fused += samples[n].fused;
+            name = bucket == GGML_OP_COUNT ? "GELU" : ggml_op_name(node->op);
+            int64_t mw = 0, mb = 0;
+            for (int t = 0; t < threads; ++t) {
+                const struct ei_cpu_node_sample * s = &samples[(size_t)t * graph->n_nodes + n];
+                work += s->work_us; wait += s->wait_us;
+                kernel_wait += s->kernel_barrier_us; kernel_barriers += s->kernel_barrier_calls;
+                if (s->work_us > mw) mw = s->work_us;
+                if (s->wait_us > mb) mb = s->wait_us;
+            }
+            max_work += mw; max_wait += mb;
+            w0_work += samples[n].work_us; w0_wait += samples[n].wait_us;
+            w0_kernel_wait += samples[n].kernel_barrier_us;
+        }
+        if (nodes) fprintf(stderr, "cpu op profile: op=%s nodes=%d fused_skips=%d work_cpu_us=%" PRId64
+            " wait_cpu_us=%" PRId64 " max_work_sum_us=%" PRId64 " max_wait_sum_us=%" PRId64
+            " worker0_work_us=%" PRId64 " worker0_wait_us=%" PRId64
+            " kernel_barrier_cpu_us=%" PRId64 " worker0_kernel_barrier_us=%" PRId64 " kernel_barrier_worker_calls=%d\n",
+            name, nodes, fused, work, wait, max_work, max_wait, w0_work, w0_wait,
+            kernel_wait, w0_kernel_wait, kernel_barriers);
+    }
+    // Keep a few concrete node geometries so dominant matmuls are actionable.
+    int chosen[8];
+    for (int rank = 0; rank < 8; ++rank) {
+        int best = -1;
+        int64_t longest = -1;
+        for (int n = 0; n < graph->n_nodes; ++n) {
+            if (!samples[n].visited) continue;
+            bool seen = false;
+            for (int r = 0; r < rank; ++r) if (chosen[r] == n) seen = true;
+            if (seen) continue;
+            int64_t span = 0;
+            for (int t = 0; t < threads; ++t) {
+                const struct ei_cpu_node_sample * s = &samples[(size_t)t * graph->n_nodes + n];
+                if (s->work_us + s->wait_us > span) span = s->work_us + s->wait_us;
+            }
+            if (span > longest) { best = n; longest = span; }
+        }
+        chosen[rank] = best;
+        if (best < 0) break;
+        const struct ggml_tensor * node = graph->nodes[best];
+        fprintf(stderr, "cpu node profile: rank=%d node=%d op=%s tasks=%d fused_skips=%d"
+            " ne=%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 " src0=%s src1=%s src0_buffer=%s max_worker_span_us=%" PRId64 "\n",
+            rank, best, ggml_op_desc(node), samples[best].tasks, samples[best].fused,
+            node->ne[0], node->ne[1], node->ne[2], node->ne[3],
+            node->src[0] ? ggml_type_name(node->src[0]->type) : "none",
+            node->src[1] ? ggml_type_name(node->src[1]->type) : "none", node->src[0] && node->src[0]->buffer ? ggml_backend_buffer_name(node->src[0]->buffer) : "none", longest);
+        for (int t = 0; t < threads; ++t) {
+            const struct ei_cpu_node_sample * s = &samples[(size_t)t * graph->n_nodes + best];
+            fprintf(stderr, "cpu worker profile: node=%d worker=%d work_us=%" PRId64 " wait_us=%" PRId64
+                " kernel_barrier_us=%" PRId64 " kernel_barrier_calls=%d\n",
+                best, t, s->work_us, s->wait_us, s->kernel_barrier_us, s->kernel_barrier_calls);
+        }
+    }
+}
