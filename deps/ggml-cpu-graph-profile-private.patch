+void ggml_barrier(struct ggml_threadpool * tp) {
+    struct ei_cpu_node_sample * sample = ei_cpu_current_sample;
+    const int64_t start = sample ? ggml_time_us() : 0;
+    ei_ggml_barrier_impl(tp);
+    if (sample) {
+        sample->kernel_barrier_us += ggml_time_us() - start;
+        ++sample->kernel_barrier_calls;
+    }
 }
 
