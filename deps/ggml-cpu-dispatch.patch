+static int ggml_backend_cpu_x86_score() {
+    cpuid_x86 is;
+    uint64_t xcr0 = 0;
+    // Never issue XGETBV on a CPU/OS that has not enabled XSAVE.
+    if (is.XSAVE() && is.OSXSAVE()) {
+#ifdef _MSC_VER
+        xcr0 = _xgetbv(0);
+#else
+        uint32_t lo, hi;
+        __asm__ __volatile__("xgetbv" : "=a"(lo), "=d"(hi) : "c"(0));
+        xcr0 = (uint64_t(hi) << 32) | lo;
+#endif
+    }
+    return ggml_backend_cpu_x86_score_features(is, xcr0);
+}
+
