+    // Pair output rows while preserving each row's eight-lane accumulation.
+    // VNNI preserves its non-saturating dot product; the older path keeps
+    // the original two-stage saturating multiplication.
+    template <int RN>
+    NOINLINE void gemm4xN512(int64_t m0, int64_t m, int64_t n0, int64_t n) {
+        const int64_t xtiles = (n - n0) / RN;
+        const int64_t tiles = xtiles * ((m - m0) / 4);
+        const int64_t duty = (tiles + nth - 1) / nth;
+#if !(defined(__AVX512VNNI__) && defined(__AVX512VL__))
+        const __m512i ones = _mm512_set1_epi16(1);
+#endif
+        for (int64_t job = duty * ith; job < MIN(duty * (ith + 1), tiles); ++job) {
+            const int64_t ii = m0 + job / xtiles * 4;
+            const int64_t jj = n0 + job % xtiles * RN;
