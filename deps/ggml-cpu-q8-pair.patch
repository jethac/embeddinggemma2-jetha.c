+            for (int64_t l = 0; l < k; ++l) {
+                const uint64_t a_delta = ((uint64_t)A[lda * (ii + 3) + l].d << 48) |
+                    ((uint64_t)A[lda * (ii + 2) + l].d << 32) |
+                    ((uint64_t)A[lda * (ii + 1) + l].d << 16) | A[lda * ii + l].d;
+                const __m128 da = _mm_cvtph_ps(_mm_set_epi64x(0, a_delta));
+                __m512i av[2], magnitude[2];
+                __mmask64 negative[2];
+                for (int pair = 0; pair < 2; ++pair) {
+                    av[pair] = _mm512_inserti64x4(_mm512_castsi256_si512(load(A + lda * (ii + pair * 2) + l)),
+                        load(A + lda * (ii + pair * 2 + 1) + l), 1);
+                    magnitude[pair] = _mm512_abs_epi8(av[pair]);
+                    negative[pair] = _mm512_cmp_epi8_mask(av[pair], _mm512_setzero_si512(), _MM_CMPINT_LT);
+                }
+                for (int j = 0; j < RN; ++j) {
+                    const __m128 d = _mm_mul_ps(da, _mm_set1_ps(unhalf(B[ldb * (jj + j) + l].d)));
