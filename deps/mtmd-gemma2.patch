+// EmbeddingGemma 2 expands even small images to its prescribed patch budget.
+// Floor both sides, preserving aspect ratio and pooling-grid alignment.
+mtmd_image_preproc_out mtmd_image_preprocess_patch_budget(
+        const clip_hparams & hparams, const clip_image_u8 & img, int max_soft_tokens) {
+    const auto size = img.get_size();
+    const int side = hparams.patch_size * hparams.n_merge;
+    if (size.width <= 0 || size.height <= 0 || max_soft_tokens <= 0 || side <= 0) {
+        throw std::runtime_error("invalid patch-budget resize");
+    }
+    const double factor = std::sqrt(double(max_soft_tokens) * side * side /
+                                    (double(size.width) * size.height));
+    int width = int(std::floor(factor * size.width / side)) * side;
+    int height = int(std::floor(factor * size.height / side)) * side;
+    // Match the reference processor's extreme-aspect-ratio handling.
+    if (!height) {
+        height = side;
+        width = std::min(int(std::floor(double(size.width) / size.height)), max_soft_tokens) * side;
+    } else if (!width) {
+        width = side;
+        height = std::min(int(std::floor(double(size.height) / size.width)), max_soft_tokens) * side;
+    }
+    clip_image_u8 resized;
+    img_tool::resize(img, resized, {width, height}, RESIZE_ALGO_BICUBIC, PAD_NONE);
+    mtmd_image_preproc_out output;
+    output.append(hparams, resized, true);
+    return output;
+}
