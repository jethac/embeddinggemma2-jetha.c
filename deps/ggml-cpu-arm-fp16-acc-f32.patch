+inline static void ggml_arm_flash_mad_f16_acc_f32(int n, ggml_fp16_t * y, const ggml_fp16_t * x, float v) {
+    const float32x4_t scale = vdupq_n_f32(v);
+    const int np = n & ~15; // baseline NEON vector prefix; same scalar tail
+    int i = 0;
+    for (; i < np; i += 4) {
+        const float32x4_t value = vcvt_f32_f16(vld1_f16((const __fp16 *) (x + i)));
+        const float32x4_t accum = vcvt_f32_f16(vld1_f16((const __fp16 *) (y + i)));
+        vst1_f16((__fp16 *) (y + i), vcvt_f16_f32(vfmaq_f32(accum, value, scale)));
+    }
