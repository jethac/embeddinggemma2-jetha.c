+        std::thread watchdog;
+        std::mutex deadline_mutex;
+        std::condition_variable deadline_done;
+        bool cancelled = false;
+        bool failed = false;
+        std::atomic<bool> timed_out{false};
+
+        void start_deadline(uint32_t ms, const char *operation) {
+            if (!ms) return;
+            watchdog = std::thread([this, ms, operation]() {
+                std::unique_lock<std::mutex> lock(deadline_mutex);
+                if (!deadline_done.wait_for(lock, std::chrono::milliseconds(ms), [this]() { return cancelled; })) {
+                    timed_out = true;
+                    subprocess_terminate(&proc);
+                    LOG_ERR("%s subprocess deadline exceeded after %u ms\n", operation, ms);
+                }
+            });
+        }
+        void cancel_deadline() {
+            { std::lock_guard<std::mutex> lock(deadline_mutex); cancelled = true; }
+            deadline_done.notify_one();
+            if (watchdog.joinable()) watchdog.join();
+        }
 
