+                    #if defined(__ARM_FEATURE_ATOMICS) || defined(__ARM_FEATURE_CRC32) || defined(__ARM_FEATURE_QRDMX) || defined(__ARM_FEATURE_FP16_FML) || defined(__ARM_FEATURE_MATMUL_INT8) || defined(__ARM_FEATURE_BF16_VECTOR_ARITHMETIC) || defined(__ARM_FEATURE_SVE) || defined(__ARM_FEATURE_SME)
