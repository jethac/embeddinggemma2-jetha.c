--- a/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
@@ -7,6 +7,14 @@
     int score = 1;
     const ggml_feats_arch64_runtime_t af = ggml_feats_get_arch64_runtime();
     GGML_UNUSED(af);
+
+#ifdef GGML_USE_ARMV82_BASELINE
+    // Linux ARMv8.2 variants inherit CRC32, LSE atomics and RDM from ARMv8.1.
+    // These are optional on older CPUs even when DOTPROD/FP16 are available.
+    const unsigned long hwcap = getauxval(AT_HWCAP);
+    const unsigned long required = (1UL << 7) | (1UL << 8) | (1UL << 12);
+    if ((hwcap & required) != required) { return 0; }
+#endif
 
 #ifdef GGML_USE_DOTPROD
     if (!af.has_dotprod) { return 0; }
